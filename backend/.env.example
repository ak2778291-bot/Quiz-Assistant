# Copy to backend/.env for local (non-Docker) development.

DATABASE_URL=postgresql+asyncpg://edugen:edugen@localhost:5433/edugen

JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# --- LLM ---------------------------------------------------------------------
# "gemini" is the real provider and needs GEMINI_API_KEY.
# "stub" is an explicitly opt-in offline generator (still grounded in retrieved
# chunks) so the project runs end-to-end without a key. It is never selected
# automatically.
LLM_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings --------------------------------------------------------------
# "local" is a deterministic hashed bag-of-words embedder (768 dims, no network).
# "gemini" uses text-embedding-004. Re-run the ingestion script after switching.
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=768

# --- Retrieval / quiz shape --------------------------------------------------
RETRIEVAL_TOP_K=6
QUESTIONS_PER_QUIZ=5
MIN_CHUNKS_FOR_GENERATION=2

ENABLE_GENERATION_CACHE=true
CORS_ORIGINS=http://localhost:3000
